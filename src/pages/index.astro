---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import Footer from '../components/Footer.astro';
import { getSiteData, getSections, getPageContent } from '../lib/data';
import '../styles/beranda.css';
const G = await getSiteData();
const sectionConfig = await getSections('/');
const pageContent = await getPageContent('/');
const cmsTeachersEyebrow = pageContent.teachersEyebrow || "Tim Pengajar";
const cmsTeachersTitle = pageContent.teachersTitle || "Arsitek Kompetensi Kami";
const sectionVisible = (key) => sectionConfig.find((item) => item.section_key === key)?.enabled !== false;
const sectionOrder = (key, fallback) => sectionConfig.find((item) => item.section_key === key)?.sort_order ?? fallback;
const hero = G.hero || {};

// Utility functions for pre-rendering
function makeInitials(name = "") {
  return name.split(" ").slice(0, 2).map(w => w[0]?.toUpperCase() || "").join("");
}

const stats = G.stats || [];
const guru = G.guru || [];

---

<Layout title={`${G.namaKelas || "TKJ XI-9"} - Beranda | ${G.namaSekolah || "SMK Muhammadiyah Belitang"}`}>
  <Intro />
  <Header />

  <main id="main-content" style="display:flex;flex-direction:column">
    <section class="hero" aria-label="Selamat datang di TKJ XI-9" style={`order:${sectionOrder("hero",0)};display:${sectionVisible("hero") ? "" : "none"}`}>
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-floats" aria-hidden="true">
        <div class="float-icon fi1"><i class="fas fa-network-wired"></i></div>
        <div class="float-icon fi2"><i class="fas fa-code"></i></div>
        <div class="float-icon fi3"><i class="fas fa-shield-halved"></i></div>
        <div class="float-icon fi4"><i class="fas fa-microchip"></i></div>
        <div class="float-icon fi5"><i class="fas fa-terminal"></i></div>
        <div class="float-icon fi6"><i class="fas fa-server"></i></div>
      </div>
      <div class="hero-content">
        <div class="hero-eyebrow">{hero.eyebrow || "Teknik Komputer &amp; Jaringan"}</div>
        <h1 class="hero-title">
          {hero.schoolPrefix || 'SMK'} <span class="hl glitch-text" data-text={hero.highlight || 'MUBELA'}>{hero.highlight || 'MUBELA'}</span><br />{hero.classLabel || `${G.namaKelas || 'XI-9'} TKJ.`}
        </h1>
        <p
          class="hero-desc"
          id="slogan-pahlawan"
          aria-live="polite"
        >
          {G.sloganHero}
        </p>
        <div class="hero-cta">
          <a href={hero.primaryHref || "/pengembang"} class="tombol tombol-utama"
            >{hero.primaryText || "Kenali Kami"} <i class="fas fa-arrow-right" aria-hidden="true"></i
          ></a>
          <a href={hero.secondaryHref || "/anggota"} class="tombol tombol-garis">{hero.secondaryText || "Lihat Anggota"}</a>
        </div>
      </div>
    </section>

    <!-- Stats Strip -->
    <section class="stats-section reveal" aria-label="Statistik kelas" style={`order:${sectionOrder("stats",1)};display:${sectionVisible("stats") ? "" : "none"}`}>
      <div class="wadah">
        <div id="strip-statistik" class="strip-statistik">
          {stats.map((s) => (
            <div class="stat-cell reveal">
              <div class="stat-num" data-target={s.angka} data-suffix={s.suffix || ""}>
                0{s.suffix || ""}
              </div>
              <div class="stat-lbl">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Guru Section -->
    <section id="guru-section" class="wadah reveal" aria-label="Tim Pengajar TKJ XI-9" style={`order:${sectionOrder("teachers",2)};display:${sectionVisible("teachers") ? "" : "none"}`}>
      <div class="sec-header">
        <div class="sec-tag">{cmsTeachersEyebrow}</div>
        <h2 class="sec-title">{cmsTeachersTitle}</h2>
      </div>
      <div class="grid-guru">
        {guru.map((g, i) => (
          <div class="card guru-card card-accent-top reveal" style={`--d: ${i * 0.08}s`}>
            <div class="avatar lg avatar-ring" style="margin:0 auto 14px">
              {g.foto ? (
                <img src={g.foto} alt={g.nama} loading="lazy" />
              ) : (
                <span>{makeInitials(g.nama)}</span>
              )}
            </div>
            <div style="text-align:center;margin-bottom:8px">
              <div style="font-weight:700;font-size:var(--text-md);color:var(--text-1)">{g.nama}</div>
              <span class="chip" style="margin-top:4px">{g.mapel}</span>
            </div>
            <div class="guru-role">{g.peran}</div>
            <blockquote class="guru-quote">{g.quote}</blockquote>
            <div class="guru-power-label">// POWER LEVEL</div>
            <div class="guru-bars">
              {(g.expertise || []).map((e) => (
                <div class="guru-bar-item">
                  <div class="guru-bar-meta">
                    <span>{e.label}</span>
                    <span>{e.level}%</span>
                  </div>
                  <div class="bar-bg">
                    <div class="bar-fill" data-level={e.level} style="width: 0%"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import '../scripts/beranda.js';
  </script>
</Layout>
