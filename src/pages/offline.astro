---
// offline.astro — TKJ XI-9 | Halaman Offline
// Ditampilkan oleh Service Worker saat pengguna offline
import Layout from '../layouts/Layout.astro';
---

<Layout title="Offline — TKJ XI-9" description="Tidak ada koneksi internet. Beberapa halaman mungkin masih tersedia dari cache.">
  <main
    id="main-content"
    style="min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;text-align:center;"
  >
    <div class="ol-icon" aria-hidden="true">
      <i class="fas fa-wifi"></i>
    </div>
    <h1 class="ol-title">Kamu Sedang Offline</h1>
    <p class="ol-desc">
      Tidak ada koneksi internet. Beberapa halaman yang sudah kamu kunjungi
      sebelumnya mungkin masih bisa diakses dari cache.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap">
      <a href="/" class="tombol tombol-utama">
        <i class="fas fa-house" aria-hidden="true"></i> Coba Beranda
      </a>
      <button class="tombol tombol-garis" onclick="window.location.reload()">
        <i class="fas fa-rotate-right" aria-hidden="true"></i> Coba Lagi
      </button>
    </div>
    <p class="ol-info">
      Halaman di-cache saat online: index · anggota · galeri · keahlian · tkj
    </p>
  </main>
</Layout>

<style>
  .ol-icon {
    font-size: 4rem;
    color: var(--text-3);
    animation: pulse 2s ease-in-out infinite;
    margin-bottom: 20px;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  .ol-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 10px;
  }

  .ol-desc {
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 380px;
    margin: 0 auto 28px;
  }

  .ol-info {
    font-family: 'Fira Code', monospace;
    font-size: var(--text-xs);
    color: var(--text-3);
    margin-top: 20px;
    letter-spacing: 0.08em;
  }
</style>
