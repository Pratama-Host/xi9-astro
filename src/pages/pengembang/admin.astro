---
const pageTitle = 'CMS Admin — TKJ XI-9';
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#111018" />
  <title>{pageTitle}</title>
  <style is:global>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color-scheme:dark;background:#0c0d12;color:#f4f4f5;font-synthesis:none;--bg:#0c0d12;--panel:#151720;--panel2:#1b1e29;--line:#2a2e3b;--muted:#a1a1aa;--red:#dc3545;--red2:#a91e2b;--green:#22c55e;--amber:#f59e0b;--radius:16px}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(900px 500px at 95% -10%,#38202b55,transparent 60%),var(--bg)}button,input,textarea,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.hidden{display:none!important}.muted{color:var(--muted)}.small{font-size:.82rem}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;color:#e68b94;font-weight:750}.btn{border:1px solid transparent;border-radius:10px;padding:10px 14px;background:var(--red);color:white;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px}.btn:hover{background:#ef4657}.btn:disabled{opacity:.55;cursor:wait}.btn.ghost{background:#222632;border-color:#363b4b;color:#e7e7eb}.btn.danger{background:#5b2028;border-color:#8f2f3a}.btn.small-btn{padding:7px 10px;font-size:.82rem}.field{display:flex;flex-direction:column;gap:7px;min-width:0}.field label{font-size:.83rem;color:#d4d4d8;font-weight:650}.field input,.field textarea,.field select,.control{width:100%;background:#0e1017;color:#f4f4f5;border:1px solid #343847;border-radius:10px;padding:11px 12px;outline:none;min-width:0}.field input:focus,.field textarea:focus,.field select:focus,.control:focus{border-color:#e05260;box-shadow:0 0 0 3px #e0526022}.field textarea{min-height:100px;resize:vertical;line-height:1.55}.field input[type=checkbox],.field input[type=color]{width:auto;min-height:24px;padding:0}.field input[type=file]{padding:9px}.field input[type=range]{padding:0}.grid{display:grid;gap:14px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.panel{background:linear-gradient(145deg,#171a24,#12141c);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:0 18px 50px #0002}.panel h2,.panel h3{margin:0 0 7px}.panel-head{display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:17px}.panel-head p{margin:0}.status{min-height:1.25rem;font-size:.88rem;color:#fda4af;margin:10px 0 0}.status.ok{color:#86efac}.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.toolbar input{max-width:340px}.stats-card{padding:18px;border-radius:14px;border:1px solid var(--line);background:#171a23}.stats-card span{display:block;color:var(--muted);font-size:.84rem}.stats-card strong{display:block;font-size:1.85rem;margin-top:5px}.shell{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}.sidebar{border-right:1px solid var(--line);background:#10121aee;padding:22px 14px;position:sticky;top:0;height:100vh;overflow:auto}.brand{display:flex;align-items:center;gap:12px;padding:4px 10px 24px;border-bottom:1px solid var(--line);margin-bottom:18px}.brand-mark{width:42px;height:42px;border-radius:13px;background:linear-gradient(140deg,#f04c5b,#7f1824);display:grid;place-items:center;font-weight:900;font-size:.85rem;box-shadow:0 7px 22px #e33b4a33}.brand strong{display:block;font-size:.95rem}.brand small{color:var(--muted);font-size:.74rem}.nav-group{margin:18px 8px 8px;color:#777f90;font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;font-weight:800}.nav-btn{width:100%;display:flex;align-items:center;gap:11px;text-align:left;padding:11px 12px;border:1px solid transparent;border-radius:10px;background:transparent;color:#c7cad3;margin:3px 0;font-weight:620}.nav-btn .ic{width:20px;text-align:center;color:#9399a8}.nav-btn:hover{background:#1b1f2a}.nav-btn.active{background:#48212a;border-color:#74313d;color:white}.nav-btn.active .ic{color:#ff9aa4}.sidebar-bottom{border-top:1px solid var(--line);margin-top:22px;padding:16px 8px 0}.main{min-width:0;padding:26px clamp(16px,3vw,38px) 60px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px}.topbar h1{font-size:clamp(1.5rem,3vw,2rem);margin:4px 0}.topbar p{margin:0;color:var(--muted);font-size:.9rem}.view{display:none}.view.active{display:block}.view-intro{margin-bottom:20px}.view-intro h2{font-size:1.25rem;margin:0 0 6px}.view-intro p{margin:0;color:var(--muted);line-height:1.55}.form-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:16px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{border-collapse:collapse;width:100%;min-width:680px}th,td{padding:12px 13px;border-bottom:1px solid var(--line);text-align:left;font-size:.87rem}th{font-size:.72rem;text-transform:uppercase;letter-spacing:.09em;color:#9ca3af;background:#11141c}tbody tr:last-child td{border-bottom:0}td .btn{margin-right:5px}.badge{display:inline-flex;align-items:center;border:1px solid #3c4251;border-radius:99px;padding:4px 8px;font-size:.72rem;color:#d4d4d8}.badge.ok{border-color:#21643b;color:#86efac;background:#10351e55}.badge.off{border-color:#735b2b;color:#fcd34d;background:#4b351c55}.item-list{display:grid;gap:10px}.editor-row{display:grid;grid-template-columns:minmax(0,1fr) 110px 110px auto;gap:9px;align-items:center;border:1px solid var(--line);padding:11px;border-radius:12px;background:#11141c}.media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:12px}.media-card{overflow:hidden;border:1px solid var(--line);background:#11141c;border-radius:13px}.media-card img,.media-card .file-preview{display:block;width:100%;height:130px;object-fit:cover;background:#090b10}.media-card .file-preview{display:grid;place-items:center;color:#a1a1aa;font-size:2rem}.media-card-body{padding:10px}.media-card-body strong{display:block;font-size:.85rem;word-break:break-word}.media-card-body small{display:block;color:var(--muted);margin:5px 0 9px}.preview-img{max-width:180px;max-height:110px;object-fit:contain;background:#090b10;border:1px solid var(--line);border-radius:10px;padding:4px}.checkline{display:flex;align-items:center;gap:9px;color:#d4d4d8;font-size:.88rem}.checkline input{accent-color:var(--red);width:17px;height:17px}.notice{padding:12px 14px;border-radius:11px;border:1px solid #705329;background:#44301755;color:#fcdca2;font-size:.84rem;line-height:1.5}.empty{padding:24px;text-align:center;color:var(--muted);border:1px dashed #414657;border-radius:12px}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(440px,100%);background:#171a23;border:1px solid #353a49;border-radius:20px;padding:28px;box-shadow:0 30px 90px #0007}.login-card h1{margin:8px 0}.mobile-menu{display:none}
    @media(max-width:900px){.shell{grid-template-columns:205px minmax(0,1fr)}.sidebar{padding:18px 9px}.main{padding:20px 16px 50px}.grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:680px){.shell{display:block}.sidebar{position:fixed;z-index:30;left:0;top:0;bottom:0;width:min(290px,84vw);height:100dvh;transform:translateX(-105%);transition:transform .22s ease;box-shadow:20px 0 60px #0008}.sidebar.open{transform:translateX(0)}.mobile-menu{display:inline-flex}.main{padding:15px 12px 40px}.topbar{align-items:flex-start}.topbar h1{font-size:1.45rem}.grid.two,.grid.three{grid-template-columns:1fr}.panel{padding:15px}.editor-row{grid-template-columns:1fr 1fr}.editor-row input:first-child{grid-column:1/-1}.editor-row .checkline{grid-column:1}.editor-row button{grid-column:2}.media-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stats-card strong{font-size:1.55rem}}
  </style>
</head>
<body>
  <section id="login-screen" class="login-wrap">
    <div class="login-card">
      <div class="brand-mark">XI9</div>
      <p class="eyebrow">TKJ XI-9 · Content Management</p>
      <h1>Masuk ke CMS</h1>
      <p class="muted">Kelola konten, anggota, galeri, media, dan pengaturan website dari satu tempat.</p>
      <form id="login-form" class="grid" style="gap:12px;margin-top:22px">
        <div class="field"><label for="admin-password">Password admin</label><input id="admin-password" type="password" autocomplete="current-password" required /></div>
        <button class="btn" id="login-button" type="submit">Masuk ke dashboard</button>
        <p id="login-status" class="status" role="status"></p>
      </form>
      <a class="muted small" href="/pengembang" style="display:inline-block;margin-top:16px">← Kembali ke website</a>
    </div>
  </section>

  <div id="admin-shell" class="shell hidden">
    <aside id="sidebar" class="sidebar">
      <div class="brand"><div class="brand-mark">XI9</div><div><strong>TKJ XI-9 CMS</strong><small>Website Control Center</small></div></div>
      <div class="nav-group">Ringkasan</div>
      <button class="nav-btn active" data-view="dashboard"><span class="ic">▦</span> Dashboard</button>
      <div class="nav-group">Konten website</div>
      <button class="nav-btn" data-view="members"><span class="ic">♙</span> Anggota</button>
      <button class="nav-btn" data-view="gallery"><span class="ic">▧</span> Galeri</button>
      <button class="nav-btn" data-view="content"><span class="ic">✎</span> Konten & profil</button>
      <button class="nav-btn" data-view="collections"><span class="ic">✦</span> Guru & keahlian</button>
      <button class="nav-btn" data-view="sections"><span class="ic">▤</span> Section halaman</button>
      <div class="nav-group">Pengaturan website</div>
      <button class="nav-btn" data-view="appearance"><span class="ic">◐</span> Tampilan & media</button>
      <button class="nav-btn" data-view="navigation"><span class="ic">☷</span> Navigasi</button>
      <button class="nav-btn" data-view="seo"><span class="ic">⌕</span> SEO</button>
      <button class="nav-btn" data-view="media"><span class="ic">▣</span> Media library</button>
      <button class="nav-btn" data-view="system"><span class="ic">⚙</span> Sistem & backup</button>
      <div class="sidebar-bottom"><button id="logout-button" class="btn ghost" style="width:100%">Keluar dari admin</button><a href="/" class="muted small" style="display:block;margin:14px 4px 0">↗ Lihat website publik</a></div>
    </aside>

    <main class="main">
      <div class="topbar">
        <div><button id="mobile-menu" class="btn ghost mobile-menu" type="button">☰ Menu</button><p class="eyebrow">Pusat pengelolaan website</p><h1 id="view-title">Dashboard</h1><p id="view-subtitle">Ringkasan kondisi website TKJ XI-9.</p></div>
        <span id="connection-status" class="badge">Memeriksa Supabase…</span>
      </div>

      <section id="view-dashboard" class="view active">
        <div class="grid three" id="dashboard-stats">
          <div class="stats-card"><span>Anggota</span><strong>—</strong></div><div class="stats-card"><span>Galeri</span><strong>—</strong></div><div class="stats-card"><span>Media</span><strong>—</strong></div>
        </div>
        <div class="grid two" style="margin-top:14px">
          <div class="panel"><div class="panel-head"><div><h2>Aktivitas terbaru</h2><p class="muted small">Riwayat perubahan yang tercatat di CMS.</p></div><button class="btn ghost small-btn" data-go="media">Media library</button></div><div id="activity-list" class="item-list"><div class="empty">Memuat aktivitas…</div></div></div>
          <div class="panel"><h2>Pintasan pengelolaan</h2><p class="muted small">Buka modul yang ingin diperbarui.</p><div class="grid two" style="margin-top:14px"><button class="btn ghost" data-go="members">Kelola anggota</button><button class="btn ghost" data-go="gallery">Kelola galeri</button><button class="btn ghost" data-go="content">Edit konten</button><button class="btn ghost" data-go="appearance">Atur tampilan</button><button class="btn ghost" data-go="navigation">Atur navigasi</button><button class="btn ghost" data-go="seo">Pengaturan SEO</button></div><div class="notice" style="margin-top:16px">Status tersambung berarti endpoint admin berhasil membaca tabel CMS. Ukuran media dihitung dari metadata file yang tercatat, bukan kuota total bucket.</div><p id="dashboard-status" class="status"></p></div>
        </div>
      </section>

      <section id="view-members" class="view">
        <div class="view-intro"><h2>Manajemen anggota</h2><p>Kelola identitas, jabatan, media profil, keterampilan, urutan, dan visibilitas anggota.</p></div>
        <div class="panel">
          <div class="panel-head"><div><h2 id="member-form-title">Tambah anggota</h2><p class="muted small">NIS menjadi identitas unik anggota.</p></div><span id="member-dirty" class="badge hidden">Belum disimpan</span></div>
          <form id="member-form" class="grid">
            <input type="hidden" id="original_nis" />
            <div class="grid two"><div class="field"><label for="member-nama">Nama lengkap *</label><input id="member-nama" maxlength="160" required /></div><div class="field"><label for="member-nis">NIS *</label><input id="member-nis" maxlength="40" required /></div><div class="field"><label for="member-kelas">Kelas</label><input id="member-kelas" value="XI-9" maxlength="40" /></div><div class="field"><label for="member-jabatan">Jabatan</label><input id="member-jabatan" maxlength="100" /></div><div class="field"><label for="member-foto">URL foto profil</label><input id="member-foto" type="url" /></div><div class="field"><label for="member-photo-file">Upload foto profil (opsional)</label><input id="member-photo-file" type="file" accept="image/*" /></div><div class="field"><label for="member-audio">URL audio profil</label><input id="member-audio" type="url" /></div><div class="field"><label for="member-audio-nama">Nama audio</label><input id="member-audio-nama" /></div><div class="field"><label for="member-foto-audio">URL foto audio</label><input id="member-foto-audio" type="url" /></div></div>
            <div class="field"><label for="member-desc">Deskripsi</label><textarea id="member-desc"></textarea></div>
            <div class="grid two"><div class="field"><label for="member-desc-audio">Deskripsi audio</label><textarea id="member-desc-audio"></textarea></div><div class="field"><label for="member-skills">Skill anggota (pisahkan dengan koma)</label><input id="member-skills" placeholder="Networking, Linux, Web Development" /></div></div>
            <div class="field"><label for="member-social">Media sosial (JSON object)</label><textarea id="member-social" placeholder='{"instagram":"https://..."}'></textarea></div>
            <div class="grid two"><div class="field"><label for="member-order">Urutan</label><input id="member-order" type="number" min="0" value="0" /></div><label class="checkline" style="align-self:end"><input id="member-visible" type="checkbox" checked /> Tampilkan di website publik</label></div>
            <div class="form-actions"><button class="btn" id="save-member" type="submit">Simpan anggota</button><button class="btn ghost" id="reset-member" type="button">Batal / anggota baru</button></div><p id="member-status" class="status"></p>
          </form>
        </div>
        <div class="panel"><div class="panel-head"><div><h2>Daftar anggota</h2><p class="muted small" id="members-count">Memuat data…</p></div><div class="toolbar"><input id="member-search" class="control" placeholder="Cari nama, NIS, jabatan…" /><button class="btn ghost small-btn" id="refresh-members">Muat ulang</button></div></div><div class="table-wrap"><table><thead><tr><th>Nama</th><th>NIS</th><th>Kelas</th><th>Jabatan</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="members-table"><tr><td colspan="6">Memuat data…</td></tr></tbody></table></div></div>
      </section>

      <section id="view-gallery" class="view">
        <div class="view-intro"><h2>Manajemen galeri</h2><p>Upload beberapa foto sekaligus, atur caption, judul, kategori, tanggal dokumentasi, visibilitas, dan urutan.</p></div>
        <div class="panel"><h2>Tambah foto galeri</h2><form id="gallery-upload-form" class="grid"><div class="grid two"><div class="field"><label for="gallery-files">Pilih foto (bisa beberapa)</label><input id="gallery-files" type="file" accept="image/*" multiple required /></div><div class="field"><label for="gallery-caption-default">Caption awal (opsional)</label><input id="gallery-caption-default" maxlength="240" placeholder="Kegiatan kelas..." /></div></div><button class="btn" id="gallery-upload-button" type="submit">Upload foto ke galeri</button><p id="gallery-upload-status" class="status"></p></form></div>
        <div class="panel"><div class="panel-head"><div><h2>Semua foto</h2><p class="muted small" id="gallery-count">Memuat galeri…</p></div><button class="btn ghost small-btn" id="refresh-gallery">Muat ulang</button></div><div id="gallery-grid" class="media-grid"></div></div>
      </section>

      <section id="view-content" class="view">
        <div class="view-intro"><h2>Konten & profil website</h2><p>Field di bawah bersumber dari konfigurasi aktual <code>G.json</code> dan `site_settings`. Konten tersimpan sebagai JSONB dan langsung digunakan halaman publik.</p></div>
        <form id="content-form" class="grid">
          <div class="panel"><h2>Identitas website dan kelas</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-namaKelas">Nama kelas</label><input id="c-namaKelas" /></div><div class="field"><label for="c-jurusan">Jurusan</label><input id="c-jurusan" /></div><div class="field"><label for="c-namaSekolah">Nama sekolah</label><input id="c-namaSekolah" /></div><div class="field"><label for="c-tahunAjaran">Tahun ajaran</label><input id="c-tahunAjaran" /></div><div class="field"><label for="c-motto">Motto</label><input id="c-motto" /></div><div class="field"><label for="c-baseUrl">Base URL / identitas URL</label><input id="c-baseUrl" /></div></div><div class="field" style="margin-top:12px"><label for="c-deskripsi">Deskripsi kelas</label><textarea id="c-deskripsi"></textarea></div></div>
          <div class="panel"><h2>Hero beranda</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-hero-eyebrow">Label kecil hero</label><input id="c-hero-eyebrow" /></div><div class="field"><label for="c-hero-school">Teks sebelum highlight</label><input id="c-hero-school" /></div><div class="field"><label for="c-hero-highlight">Teks highlight</label><input id="c-hero-highlight" /></div><div class="field"><label for="c-hero-class">Teks kelas</label><input id="c-hero-class" /></div><div class="field"><label for="c-hero-primary">Tombol utama</label><input id="c-hero-primary" /></div><div class="field"><label for="c-hero-primary-href">Link tombol utama</label><input id="c-hero-primary-href" /></div><div class="field"><label for="c-hero-secondary">Tombol kedua</label><input id="c-hero-secondary" /></div><div class="field"><label for="c-hero-secondary-href">Link tombol kedua</label><input id="c-hero-secondary-href" /></div></div><div class="field" style="margin-top:12px"><label for="c-sloganHero">Subjudul / slogan hero</label><textarea id="c-sloganHero"></textarea></div></div>
          <div class="panel"><h2>Visi, misi, dan wali kelas</h2><div class="field" style="margin-top:14px"><label for="c-visi">Visi</label><textarea id="c-visi"></textarea></div><div class="field"><label for="c-misi">Misi (satu item per baris)</label><textarea id="c-misi"></textarea></div><div class="grid two"><div class="field"><label for="c-wali-nama">Nama wali kelas</label><input id="c-wali-nama" /></div><div class="field"><label for="c-wali-jabatan">Jabatan wali kelas</label><input id="c-wali-jabatan" /></div><div class="field"><label for="c-wali-foto">Foto wali kelas</label><input id="c-wali-foto" type="url" /></div><div class="field"><label for="c-wali-desc">Deskripsi wali kelas</label><input id="c-wali-desc" /></div></div></div>
          <div class="panel"><h2>Profil developer / Masdo</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-masdo-nama">Nama</label><input id="c-masdo-nama" /></div><div class="field"><label for="c-masdo-jabatan">Jabatan</label><input id="c-masdo-jabatan" /></div><div class="field"><label for="c-masdo-foto">Foto profil</label><input id="c-masdo-foto" type="url" /></div><div class="field"><label for="c-masdo-skills">Keahlian (pisahkan koma)</label><input id="c-masdo-skills" /></div></div></div>
          <div class="panel"><h2>Konten beranda dan halaman TKJ</h2><p class="muted small">Bagian daftar menggunakan JSON terstruktur. Pertahankan nama properti yang ditampilkan contoh ketika mengubahnya.</p><div class="grid two" style="margin-top:14px"><div class="field"><label for="c-stats">Statistik beranda (JSON array)</label><textarea id="c-stats" class="json-editor" spellcheck="false"></textarea></div><div class="field"><label for="c-prestasi">Prestasi (JSON array)</label><textarea id="c-prestasi" class="json-editor" spellcheck="false"></textarea></div><div class="field"><label for="c-tkj">Data halaman TKJ (JSON object)</label><textarea id="c-tkj" class="json-editor" spellcheck="false"></textarea></div><div class="field"><label for="c-countdown">Countdown (JSON object)</label><textarea id="c-countdown" class="json-editor" spellcheck="false"></textarea></div></div><div class="field" style="margin-top:12px"><label for="c-social">Media sosial (JSON object)</label><textarea id="c-social" class="json-editor" spellcheck="false"></textarea></div><div class="field" style="margin-top:12px"><label for="c-footer">Tautan footer (JSON object dengan links[])</label><textarea id="c-footer" class="json-editor" spellcheck="false"></textarea></div></div>
          <div class="form-actions"><button class="btn" id="save-content" type="submit">Simpan seluruh konten</button><button class="btn ghost" id="reload-content" type="button">Muat ulang dari Supabase</button><span id="content-dirty" class="badge hidden">Ada perubahan belum disimpan</span></div><p id="content-status" class="status"></p>
        </form>
      </section>

      <section id="view-collections" class="view">
        <div class="view-intro"><h2>Guru dan keahlian</h2><p>Kedua data ini memakai tabel `guru` dan `skills` yang sudah ada. Editor JSON menjaga seluruh properti aktual tanpa mengganti struktur tabel.</p></div>
        <div class="panel"><div class="panel-head"><div><h2>Data guru</h2><p class="muted small">nama, mapel, peran, quote, expertise[]</p></div><button class="btn ghost small-btn" id="reload-guru">Muat ulang</button></div><div class="field"><label for="guru-json">Daftar guru (JSON array)</label><textarea id="guru-json" class="json-editor" style="min-height:260px" spellcheck="false"></textarea></div><div class="form-actions"><button class="btn" id="save-guru">Simpan data guru</button></div><p id="guru-status" class="status"></p></div>
        <div class="panel"><div class="panel-head"><div><h2>Data keahlian</h2><p class="muted small">nama, level (0–100), icon, deskripsi</p></div><button class="btn ghost small-btn" id="reload-skills">Muat ulang</button></div><div class="field"><label for="skills-json">Daftar keahlian (JSON array)</label><textarea id="skills-json" class="json-editor" style="min-height:260px" spellcheck="false"></textarea></div><div class="form-actions"><button class="btn" id="save-skills">Simpan data keahlian</button></div><p id="skills-status" class="status"></p></div>
      </section>

      <section id="view-appearance" class="view">
        <div class="view-intro"><h2>Tampilan dan media global</h2><p>Atur aset brand, tema, warna, latar belakang, dan audio. Media upload akan masuk ke bucket <code>astro</code>.</p></div>
        <form id="appearance-form" class="grid">
          <div class="panel"><h2>Aset website</h2><div class="grid two" style="margin-top:14px"><div class="field"><label for="a-logo">Logo utama URL</label><input id="a-logo" type="url"/><img id="preview-logo" class="preview-img hidden" alt="Preview logo"/></div><div class="field"><label for="a-logo-alt">Logo alternatif URL</label><input id="a-logo-alt" type="url"/><img id="preview-logo-alt" class="preview-img hidden" alt="Preview logo alternatif"/></div><div class="field"><label for="a-favicon">Favicon URL</label><input id="a-favicon" type="url"/><img id="preview-favicon" class="preview-img hidden" alt="Preview favicon"/></div><div class="field"><label for="a-background">Background image URL</label><input id="a-background" type="url"/><img id="preview-background" class="preview-img hidden" alt="Preview background"/></div><div class="field"><label for="a-og">Open Graph image URL</label><input id="a-og" type="url"/><img id="preview-og" class="preview-img hidden" alt="Preview OG"/></div><div class="field"><label for="a-audio">Audio latar URL</label><input id="a-audio" type="url"/></div></div></div>
          <div class="panel"><h2>Tema dan warna</h2><div class="grid three" style="margin-top:14px"><div class="field"><label for="a-theme">Tema default</label><select id="a-theme"><option value="dark">Dark</option><option value="light">Light</option><option value="blue">Blue</option></select></div><div class="field"><label for="a-accent">Warna aksen</label><input id="a-accent" type="color" value="#dc2626"/></div><div class="field"><label for="a-background-color">Warna latar</label><input id="a-background-color" type="color" value="#0a0505"/></div><div class="field"><label for="a-audio-volume">Volume default audio (0–100%)</label><input id="a-audio-volume" type="number" min="0" max="100" value="80"/></div></div><div class="notice" style="margin-top:14px">Warna yang diedit hanya berlaku untuk tema yang dipilih. Dark, Light, dan Blue menyimpan palet masing-masing.</div></div>
          <div class="form-actions"><button class="btn" type="submit" id="save-appearance">Simpan tampilan</button></div><p id="appearance-status" class="status"></p>
        </form>
        <div class="panel"><h2>Upload aset global</h2><form id="global-upload-form" class="grid"><div class="grid two"><div class="field"><label for="global-kind">Jenis aset</label><select id="global-kind"><option value="logo">Logo utama</option><option value="alternate_logo">Logo alternatif</option><option value="favicon">Favicon</option><option value="background">Background</option><option value="og">Open Graph image</option><option value="audio">Audio latar</option></select></div><div class="field"><label for="global-file">Pilih file</label><input id="global-file" type="file" required /></div></div><button class="btn" id="global-upload-button">Upload dan terapkan</button><p id="global-upload-status" class="status"></p></form></div>
      </section>

      <section id="view-navigation" class="view">
        <div class="view-intro"><h2>Manajemen navigasi</h2><p>Menu mengikuti halaman yang sudah tersedia. Tautan eksternal, API admin, dan halaman admin tidak dapat dimasukkan.</p></div>
        <div class="panel"><div class="panel-head"><div><h2>Daftar menu</h2><p class="muted small">Ubah label, tujuan, ikon Font Awesome, status, dan urutan dengan tombol naik/turun.</p></div><button class="btn ghost small-btn" id="add-navigation">+ Tambah menu</button></div><div id="navigation-list" class="item-list"></div><div class="form-actions"><button class="btn" id="save-navigation">Simpan navigasi</button><button class="btn ghost" id="reload-navigation">Muat ulang</button></div><p id="navigation-status" class="status"></p></div>
      </section>

      <section id="view-seo" class="view">
        <div class="view-intro"><h2>Pengelola SEO</h2><p>Metadata tiap halaman dipakai oleh `Layout.astro` pada saat halaman publik dirender.</p></div>
        <div class="panel"><form id="seo-form" class="grid"><div class="field"><label for="seo-page">Halaman</label><select id="seo-page"><option value="/">Beranda (/)</option><option value="/anggota">Anggota</option><option value="/galeri">Galeri</option><option value="/struktur">Struktur</option><option value="/keahlian">Keahlian</option><option value="/tkj">TKJ</option><option value="/pengembang">Pengembang</option></select></div><div class="field"><label for="seo-title">Meta title</label><input id="seo-title" maxlength="180"/></div><div class="field"><label for="seo-description">Meta description</label><textarea id="seo-description" maxlength="320"></textarea></div><div class="field"><label for="seo-og">Open Graph image URL</label><input id="seo-og" type="url"/></div><div class="field"><label for="seo-content">Konten halaman (JSON object, hanya teks/label section)</label><textarea id="seo-content" class="json-editor" style="min-height:180px" spellcheck="false" placeholder='{"headline":"Judul halaman","intro":"Deskripsi pembuka"}'></textarea><small class="muted">Kunci yang didukung: eyebrow, headline, intro, featuredEyebrow, featuredTitle, collectionEyebrow, collectionTitle, footerNote, subjectsTitle, curriculumTitle, careersTitle, teachersEyebrow, teachersTitle, devIntroText.</small></div><label class="checkline"><input id="seo-noindex" type="checkbox"/> Jangan indeks halaman ini (noindex)</label><div class="form-actions"><button class="btn" type="submit">Simpan metadata SEO</button><button class="btn ghost" type="button" id="reload-seo">Muat ulang</button></div><p id="seo-status" class="status"></p></form></div><div class="panel"><h2>Ringkasan metadata</h2><div id="seo-list" class="item-list"></div></div>
      </section>

      <section id="view-sections" class="view">
        <div class="view-intro"><h2>Pengelola section halaman</h2><p>Hanya section yang benar-benar ditemukan di markup Astro yang ditampilkan. Status tampil/sembunyi diterapkan pada section publik yang sudah terhubung.</p></div>
        <div class="panel"><div id="sections-list" class="item-list"><div class="empty">Memuat section…</div></div><div class="form-actions"><button class="btn" id="save-sections">Simpan pengaturan section</button><button class="btn ghost" id="reload-sections">Muat ulang</button></div><p id="sections-status" class="status"></p></div>
      </section>

      <section id="view-media" class="view">
        <div class="view-intro"><h2>Media library</h2><p>Seluruh upload tercatat dengan nama file, tipe, ukuran, kategori, dan URL publik. Penghapusan ditolak jika file masih direferensikan.</p></div>
        <div class="panel"><form id="media-upload-form" class="grid"><div class="grid two"><div class="field"><label for="media-category">Kategori</label><select id="media-category"><option value="assets">Aset umum</option><option value="icons">Ikon</option><option value="background">Background</option><option value="documents">Dokumen PDF</option></select></div><div class="field"><label for="media-files">File (bisa beberapa)</label><input id="media-files" type="file" multiple required/></div></div><button class="btn" id="media-upload-button">Upload ke media library</button><p id="media-upload-status" class="status"></p></form></div>
        <div class="panel"><div class="panel-head"><div><h2>File tersimpan</h2><p class="muted small" id="media-count">Memuat…</p></div><div class="toolbar"><input id="media-search" class="control" placeholder="Cari nama file…"/><select id="media-filter" class="control"><option value="">Semua kategori</option><option value="anggota">Anggota</option><option value="galeri">Galeri</option><option value="assets-global">Aset global</option><option value="assets">Aset umum</option><option value="icons">Ikon</option><option value="background">Background</option><option value="documents">Dokumen</option></select><button class="btn ghost small-btn" id="refresh-media">Muat ulang</button></div></div><div id="media-grid" class="media-grid"></div></div>
      </section>

      <section id="view-system" class="view">
        <div class="view-intro"><h2>Sistem, backup, dan riwayat</h2><p>Ekspor mencakup data dan metadata database CMS. File biner tetap tersimpan di Supabase Storage dan tidak disalin ke JSON backup.</p></div>
        <div class="panel"><h2>Backup database CMS</h2><p class="muted small">Ekspor untuk menyimpan salinan konfigurasi dan data. Import menggunakan upsert dan tidak menghapus baris lama.</p><div class="form-actions"><button id="export-backup" class="btn">Unduh backup JSON</button><label class="btn ghost" for="import-backup-file">Pilih file backup<input id="import-backup-file" type="file" accept="application/json,.json" hidden /></label></div><p id="backup-status" class="status"></p></div>
        <div class="panel"><div class="panel-head"><div><h2>Riwayat versi</h2><p class="muted small">Versi pengaturan global dan metadata halaman yang pernah disimpan.</p></div><select id="revision-page" class="control" style="max-width:200px"><option value="site-settings">Pengaturan global</option><option value="/">Beranda</option><option value="/anggota">Anggota</option><option value="/galeri">Galeri</option><option value="/struktur">Struktur</option><option value="/keahlian">Keahlian</option><option value="/tkj">TKJ</option><option value="/pengembang">Pengembang</option></select></div><div id="revision-list" class="item-list"><div class="empty">Pilih sumber riwayat.</div></div><p id="revision-status" class="status"></p></div>
      </section>

      <footer class="muted small" style="padding:26px 4px 0">TKJ XI-9 CMS · Data dikelola melalui server Astro dan Supabase Storage.</footer>
    </main>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const state = { members: [], gallery: [], content: {}, teachers: [], skills: [], navigation: [], navigationOriginal: [], pages: [], sections: [], media: [], dashboard: null };
    const pageNames = { '/':'Beranda', '/anggota':'Anggota', '/galeri':'Galeri', '/struktur':'Struktur', '/keahlian':'Keahlian', '/tkj':'TKJ', '/pengembang':'Pengembang' };
    const viewTitles = { dashboard:['Dashboard','Ringkasan kondisi website TKJ XI-9.'], members:['Anggota','Kelola data anggota dan struktur organisasi.'], gallery:['Galeri','Kelola dokumentasi dan foto kelas.'], content:['Konten & profil','Identitas, hero, visi-misi, wali kelas, developer, dan konten TKJ.'], collections:['Guru & keahlian','Kelola daftar pengajar dan kompetensi kelas.'], sections:['Section halaman','Atur section yang ditampilkan di halaman publik.'], appearance:['Tampilan & media','Kelola identitas visual, tema, warna, logo, dan audio.'], navigation:['Navigasi','Kelola menu website publik.'], seo:['SEO','Atur metadata halaman.'], media:['Media library','Kelola semua aset yang diunggah ke Storage.'], system:['Sistem & backup','Ekspor, impor, dan pulihkan riwayat versi konten.'] };
    let currentView = 'dashboard';

    async function api(url, options = {}) {
      const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store', ...options });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || `Permintaan gagal (${response.status})`);
      return payload;
    }
    function setStatus(id, message, ok = false) { const el = $(id); if (!el) return; el.textContent = message || ''; el.classList.toggle('ok', Boolean(ok)); }
    function showLogin() { $('admin-shell').classList.add('hidden'); $('login-screen').classList.remove('hidden'); }
    function showAdmin() { $('login-screen').classList.add('hidden'); $('admin-shell').classList.remove('hidden'); }
    function showView(name) {
      if (!viewTitles[name]) return;
      currentView = name;
      document.querySelectorAll('.view').forEach((v) => v.classList.toggle('active', v.id === `view-${name}`));
      document.querySelectorAll('.nav-btn').forEach((b) => b.classList.toggle('active', b.dataset.view === name));
      $('view-title').textContent = viewTitles[name][0]; $('view-subtitle').textContent = viewTitles[name][1];
      $('sidebar').classList.remove('open');
      const loaders = { members: loadMembers, gallery: loadGallery, content: loadContent, collections: loadCollections, sections: loadSections, appearance: loadAppearance, navigation: loadNavigation, seo: loadPages, media: loadMedia };
      if (loaders[name]) loaders[name]().catch((e) => console.error(e));
    }
    document.querySelectorAll('.nav-btn').forEach((button) => button.addEventListener('click', () => showView(button.dataset.view)));
    document.querySelectorAll('[data-go]').forEach((button) => button.addEventListener('click', () => showView(button.dataset.go)));
    $('mobile-menu').addEventListener('click', () => $('sidebar').classList.toggle('open'));

    $('login-form').addEventListener('submit', async (event) => {
      event.preventDefault(); $('login-button').disabled = true; setStatus('login-status', 'Memeriksa sesi admin…');
      try { await api('/api/admin/login', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify({ password: $('admin-password').value }) }); $('admin-password').value = ''; showAdmin(); await loadDashboard(); showView('dashboard'); }
      catch (e) { setStatus('login-status', e.message); }
      finally { $('login-button').disabled = false; }
    });
    $('logout-button').addEventListener('click', async () => { try { await api('/api/admin/logout', { method:'POST' }); } finally { showLogin(); } });

    async function checkSession() {
      try { await api('/api/admin/cms'); showAdmin(); await loadDashboard(); }
      catch { showLogin(); }
    }
    function formatBytes(bytes) { const n = Number(bytes || 0); if (n < 1024) return `${n} B`; if (n < 1048576) return `${(n/1024).toFixed(1)} KB`; if (n < 1073741824) return `${(n/1048576).toFixed(1)} MB`; return `${(n/1073741824).toFixed(2)} GB`; }
    function safeText(tag, value, className) { const el = document.createElement(tag); el.textContent = value ?? ''; if (className) el.className = className; return el; }
    async function loadDashboard() {
      const data = await api('/api/admin/cms'); state.dashboard = data;
      $('connection-status').textContent = '● Supabase terhubung'; $('connection-status').className = 'badge ok';
      const counts = data.counts;
      const cards = [['Anggota',counts.members],['Foto galeri',counts.gallery],['Media library',counts.media],['Konten terkelola',counts.content],['Halaman SEO',counts.pages],['Section',counts.sections]];
      $('dashboard-stats').replaceChildren(...cards.map(([label,value]) => { const card=document.createElement('div');card.className='stats-card';card.append(safeText('span',label),safeText('strong',String(value ?? 0)));return card; }));
      $('activity-list').replaceChildren();
      if (!data.activities?.length) $('activity-list').append(safeText('div','Belum ada aktivitas yang tercatat.','empty'));
      else for (const item of data.activities) { const row=document.createElement('div');row.style.cssText='padding:11px 0;border-bottom:1px solid #292d39';row.append(safeText('strong',item.summary),safeText('div',`${item.entity} · ${new Date(item.created_at).toLocaleString('id-ID')}`,'muted small'));$('activity-list').append(row); }
      $('dashboard-status').textContent = `Media tercatat: ${data.media.files} file · ${formatBytes(data.media.bytes)}. Kapasitas bucket total tidak disediakan oleh tabel metadata.`;
    }

    function resetMemberForm() { $('member-form').reset(); $('original_nis').value=''; $('member-kelas').value='XI-9'; $('member-visible').checked=true; $('member-form-title').textContent='Tambah anggota'; $('save-member').textContent='Simpan anggota'; setStatus('member-status',''); $('member-dirty').classList.add('hidden'); }
    $('reset-member').addEventListener('click',resetMemberForm);
    async function loadMembers() {
      const payload=await api('/api/admin/anggota');state.members=payload.data||[];renderMembers();
    }
    function renderMembers() {
      const q=$('member-search').value.toLowerCase().trim();const rows=state.members.filter(m=>[m.nama,m.nis,m.kelas,m.jabatan].join(' ').toLowerCase().includes(q));$('members-count').textContent=`${state.members.length} anggota · ${rows.length} ditampilkan`;
      const body=$('members-table');body.replaceChildren();
      if(!rows.length){body.append(Object.assign(document.createElement('tr'),{innerHTML:'<td colspan="6">Tidak ada anggota yang cocok.</td>'}));return;}
      for(const m of rows){const tr=document.createElement('tr');for(const v of [m.nama,m.nis,m.kelas,m.jabatan||'Anggota'])tr.append(safeText('td',v||'—'));const status=document.createElement('td');status.append(safeText('span',m.visible===false?'Disembunyikan':'Tampil',`badge ${m.visible===false?'off':'ok'}`));tr.append(status);const actions=document.createElement('td');const edit=safeText('button','Edit','btn ghost small-btn');edit.type='button';edit.addEventListener('click',()=>editMember(m));const del=safeText('button','Hapus','btn danger small-btn');del.type='button';del.addEventListener('click',()=>deleteMember(m.nis));actions.append(edit,del);tr.append(actions);body.append(tr);}
    }
    $('member-search').addEventListener('input',renderMembers);$('refresh-members').addEventListener('click',()=>loadMembers().catch(e=>setStatus('member-status',e.message)));
    function editMember(m){$('original_nis').value=m.nis||'';$('member-photo-file').value='';$('member-nama').value=m.nama||'';$('member-nis').value=m.nis||'';$('member-kelas').value=m.kelas||'XI-9';$('member-jabatan').value=m.jabatan||'';$('member-foto').value=m.foto_url||m.foto||'';$('member-audio').value=m.audio_url||m.audio||'';$('member-audio-nama').value=m.audio_nama||m.namaAudio||'';$('member-foto-audio').value=m.foto_audio_url||m.fotoAudio||'';$('member-desc').value=m.deskripsi||m.desc||'';$('member-desc-audio').value=m.deskripsi_audio||m.descAudio||'';$('member-skills').value=Array.isArray(m.skills)?m.skills.join(', '):'';$('member-social').value=JSON.stringify(m.social||{},null,2);$('member-order').value=m.urutan??0;$('member-visible').checked=m.visible!==false;$('member-form-title').textContent=`Edit anggota: ${m.nama}`;$('save-member').textContent='Simpan perubahan';$('member-form').scrollIntoView({behavior:'smooth',block:'start'});}
    $('member-form').addEventListener('input',()=> $('member-dirty').classList.remove('hidden'));
    $('member-form').addEventListener('submit',async(e)=>{e.preventDefault();let social={};try{social=JSON.parse($('member-social').value||'{}');if(!social||Array.isArray(social)||typeof social!=='object')throw Error();}catch{setStatus('member-status','Format media sosial harus JSON object yang valid.');return;}const old=$('original_nis').value;const photoFile=$('member-photo-file').files?.[0];const data={nama:$('member-nama').value,nis:$('member-nis').value,kelas:$('member-kelas').value,jabatan:$('member-jabatan').value,foto_url:$('member-foto').value,audio_url:$('member-audio').value,audio_nama:$('member-audio-nama').value,foto_audio_url:$('member-foto-audio').value,deskripsi:$('member-desc').value,deskripsi_audio:$('member-desc-audio').value,skills:$('member-skills').value.split(',').map(x=>x.trim()).filter(Boolean),social,urutan:Number($('member-order').value)||0,visible:$('member-visible').checked,original_nis:old};$('save-member').disabled=true;try{await api('/api/admin/anggota',{method:old?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(photoFile){const form=new FormData();form.append('file',photoFile);form.append('category','anggota');form.append('member_nis',data.nis);await api('/api/admin/media',{method:'POST',body:form});}setStatus('member-status','Anggota berhasil disimpan.',true);resetMemberForm();await loadMembers();await loadDashboard();}catch(e){setStatus('member-status',e.message);}finally{$('save-member').disabled=false;}});
    async function deleteMember(nis){if(!confirm(`Hapus anggota dengan NIS ${nis}? Tindakan ini tidak dapat dibatalkan.`))return;try{await api('/api/admin/anggota',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({nis,confirm:true})});await loadMembers();await loadDashboard();setStatus('member-status','Anggota berhasil dihapus.',true);}catch(e){setStatus('member-status',e.message);}}

    async function loadGallery(){const payload=await api('/api/admin/gallery');state.gallery=payload.data||[];renderGallery();}
    function renderGallery(){
      $('gallery-count').textContent=`${state.gallery.length} item galeri`;
      const grid=$('gallery-grid');grid.replaceChildren();
      if(!state.gallery.length){grid.append(safeText('div','Belum ada foto galeri.','empty'));return;}
      for(const g of state.gallery){
        const card=document.createElement('article');card.className='media-card';
        if(g.src && !String(g.src).startsWith('storage://')){
          const img=document.createElement('img');img.src=g.src;img.alt=g.alt_text||g.caption||'Foto galeri';
          img.loading='lazy';img.onerror=()=>{const fallback=safeText('div','Pratinjau tidak tersedia','file-preview');img.replaceWith(fallback);};card.append(img);
        }else{
          card.append(safeText('div','Pratinjau tidak tersedia','file-preview'));
        }
        const body=document.createElement('div');body.className='media-card-body';
        const title=safeText('strong',g.title||g.caption||'Tanpa judul');
        const meta=safeText('small',`${g.category||'Kegiatan'} · urutan ${g.urutan??0}`);
        const actions=document.createElement('div');actions.className='toolbar';
        const edit=safeText('button','Edit metadata','btn ghost small-btn');edit.type='button';edit.addEventListener('click',()=>editGallery(g));
        const toggle=safeText('button',g.visible===false?'Tampilkan':'Sembunyikan','btn ghost small-btn');toggle.type='button';toggle.addEventListener('click',()=>toggleGallery(g));
        const del=safeText('button','Hapus item','btn danger small-btn');del.type='button';del.addEventListener('click',()=>deleteGallery(g.id));
        actions.append(edit,toggle,del);body.append(title,meta,actions);card.append(body);grid.append(card);
      }
    }
    async function editGallery(g){const title=prompt('Judul foto:',g.title||'');if(title===null)return;const caption=prompt('Caption:',g.caption||'');if(caption===null)return;const description=prompt('Deskripsi:',g.description||'');if(description===null)return;const category=prompt('Kategori:',g.category||'Kegiatan');if(category===null)return;const taken_at=prompt('Tanggal (YYYY-MM-DD, kosongkan jika tidak ada):',g.taken_at||'');if(taken_at===null)return;const urutan=prompt('Urutan:',String(g.urutan??0));if(urutan===null)return;try{await api('/api/admin/gallery',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:g.id,title,caption,description,category,taken_at,urutan,alt_text:title,visible:g.visible!==false})});await loadGallery();await loadDashboard();}catch(e){alert(e.message);}}
    async function toggleGallery(g){try{await api('/api/admin/gallery',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:g.id,visible:g.visible===false})});await loadGallery();await loadDashboard();}catch(e){alert(e.message);}}
    async function deleteGallery(id){if(!confirm('Hapus item galeri dari website publik? File tetap disimpan di Media Library.'))return;try{await api('/api/admin/gallery',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,confirm:true})});await loadGallery();await loadDashboard();}catch(e){alert(e.message);}}
    $('refresh-gallery').addEventListener('click',()=>loadGallery().catch(e=>setStatus('gallery-upload-status',e.message)));
    $('gallery-upload-form').addEventListener('submit',async(e)=>{e.preventDefault();const files=[...$('gallery-files').files];if(!files.length)return;$('gallery-upload-button').disabled=true;try{for(const file of files){const form=new FormData();form.append('file',file);form.append('category','galeri');form.append('caption',$('gallery-caption-default').value.trim());await api('/api/admin/media',{method:'POST',body:form});} $('gallery-files').value='';setStatus('gallery-upload-status',`${files.length} foto berhasil diunggah.`,true);await loadGallery();await loadMedia();await loadDashboard();}catch(e){setStatus('gallery-upload-status',e.message);}finally{$('gallery-upload-button').disabled=false;}});

    function writeIf(id,value){const el=$(id);if(el)el.value=value??'';}
    function readJsonField(id,fallback){try{return JSON.parse($(id).value||JSON.stringify(fallback));}catch{throw new Error(`JSON pada ${id} tidak valid.`);}}
    async function loadContent(){const payload=await api('/api/admin/content');state.content=payload.data||{};const c=state.content;for(const k of ['namaKelas','jurusan','namaSekolah','tahunAjaran','motto','baseUrl','deskripsi','sloganHero','visi'])writeIf(`c-${k}`,c[k]);writeIf('c-misi',Array.isArray(c.misi)?c.misi.join('\n'):'');const hero=c.hero||{};for(const [id,key] of [['eyebrow','eyebrow'],['school','schoolPrefix'],['highlight','highlight'],['class','classLabel'],['primary','primaryText'],['primary-href','primaryHref'],['secondary','secondaryText'],['secondary-href','secondaryHref']])writeIf(`c-hero-${id}`,hero[key]);const wali=c.waliKelas||{};for(const [id,key] of [['nama','nama'],['jabatan','jabatan'],['foto','foto'],['desc','desc']])writeIf(`c-wali-${id}`,wali[key]);const masdo=c.masdo||{};for(const [id,key] of [['nama','nama'],['jabatan','jabatan'],['foto','foto']])writeIf(`c-masdo-${id}`,masdo[key]);writeIf('c-masdo-skills',Array.isArray(masdo.keahlian)?masdo.keahlian.join(', '):'');for(const [id,value] of [['c-stats',c.stats||[]],['c-prestasi',c.prestasi||[]],['c-tkj',c.tkj||{}],['c-countdown',c.countdown||{}],['c-social',c.sosmed||{}],['c-footer',c.footer||{}]])writeIf(id,JSON.stringify(value,null,2));$('content-dirty').classList.add('hidden');}
    $('content-form').addEventListener('input',()=> $('content-dirty').classList.remove('hidden'));
    $('content-form').addEventListener('submit',async(e)=>{e.preventDefault();let payload;try{payload={};for(const k of ['namaKelas','jurusan','namaSekolah','tahunAjaran','motto','baseUrl','deskripsi','sloganHero','visi'])payload[k]=$(`c-${k}`).value;payload.misi=$('c-misi').value.split('\n').map(x=>x.trim()).filter(Boolean);payload.hero={eyebrow:$('c-hero-eyebrow').value,schoolPrefix:$('c-hero-school').value,highlight:$('c-hero-highlight').value,classLabel:$('c-hero-class').value,primaryText:$('c-hero-primary').value,primaryHref:$('c-hero-primary-href').value,secondaryText:$('c-hero-secondary').value,secondaryHref:$('c-hero-secondary-href').value};payload.waliKelas={nama:$('c-wali-nama').value,jabatan:$('c-wali-jabatan').value,foto:$('c-wali-foto').value,desc:$('c-wali-desc').value};payload.masdo={nama:$('c-masdo-nama').value,jabatan:$('c-masdo-jabatan').value,foto:$('c-masdo-foto').value,keahlian:$('c-masdo-skills').value.split(',').map(x=>x.trim()).filter(Boolean)};payload.stats=readJsonField('c-stats',[]);payload.prestasi=readJsonField('c-prestasi',[]);payload.tkj=readJsonField('c-tkj',{});payload.countdown=readJsonField('c-countdown',{});payload.sosmed=readJsonField('c-social',{});payload.footer=readJsonField('c-footer',{});}catch(err){setStatus('content-status',err.message);return;} $('save-content').disabled=true;try{await api('/api/admin/content',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});setStatus('content-status','Konten berhasil disimpan dan digunakan halaman publik yang terhubung.',true);$('content-dirty').classList.add('hidden');await loadContent();await loadDashboard();}catch(err){setStatus('content-status',err.message);}finally{$('save-content').disabled=false;}});
    $('reload-content').addEventListener('click',()=>loadContent().catch(e=>setStatus('content-status',e.message)));

    async function loadCollection(type){const payload=await api(`/api/admin/collections?type=${type}`);state[type==='guru'?'teachers':'skills']=payload.data||[];$(type==='guru'?'guru-json':'skills-json').value=JSON.stringify(payload.data||[],null,2);}
    async function loadCollections(){await Promise.all([loadCollection('guru'),loadCollection('skills')]);}
    $('reload-guru').addEventListener('click',()=>loadCollection('guru').catch(e=>setStatus('guru-status',e.message)));$('reload-skills').addEventListener('click',()=>loadCollection('skills').catch(e=>setStatus('skills-status',e.message)));
    async function saveCollection(type){const field=type==='guru'?'guru-json':'skills-json',status=type==='guru'?'guru-status':'skills-status',button=type==='guru'?'save-guru':'save-skills';let items;try{items=JSON.parse($(field).value);if(!Array.isArray(items))throw Error('Data harus JSON array.');}catch(e){setStatus(status,`JSON tidak valid: ${e.message}`);return;}const previous=state[type==='guru'?'teachers':'skills'];const nextNames=new Set(items.map(x=>String(x?.nama||'').trim()));const removed=previous.filter(x=>!nextNames.has(x.nama));if(removed.length&&!confirm(`Daftar ini menghapus ${removed.length} data ${type} lama (${removed.map(x=>x.nama).join(', ')}). Lanjutkan?`))return;$(button).disabled=true;try{await api(`/api/admin/collections?type=${type}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({items,confirmReplace:removed.length>0})});setStatus(status,`${items.length} data ${type} berhasil disimpan.`,true);await loadCollection(type);await loadDashboard();}catch(e){setStatus(status,e.message);}finally{$(button).disabled=false;}}
    $('save-guru').addEventListener('click',()=>saveCollection('guru'));$('save-skills').addEventListener('click',()=>saveCollection('skills'));

    const themePaletteDefaults={dark:{accent_color:'#dc2626',background_color:'#0a0505'},light:{accent_color:'#0d9488',background_color:'#f8fafc'},blue:{accent_color:'#2563eb',background_color:'#020617'}};
    function syncAppearancePalette(){
      const app=state.content?.appearance||{};const theme=$('a-theme').value||'dark';
      const saved=(app.palettes||{})[theme]||{};const legacy=theme===(app.theme||'dark')?app:{};const defaults=themePaletteDefaults[theme]||themePaletteDefaults.dark;
      writeIf('a-accent',saved.accent_color||legacy.accent_color||defaults.accent_color);
      writeIf('a-background-color',saved.background_color||legacy.background_color||defaults.background_color);
    }
    async function loadAppearance(){
      if(!Object.keys(state.content).length)await loadContent();
      const c=state.content,media=c.media||{},app=c.appearance||{};
      for(const [id,value] of [['a-logo',media.logo_url],['a-logo-alt',media.alternate_logo_url],['a-favicon',media.favicon_url],['a-background',app.background_image_url],['a-og',c.ogImage],['a-audio',media.audio_url]])writeIf(id,value);
      writeIf('a-theme',app.theme||'dark');syncAppearancePalette();
      writeIf('a-audio-volume',Math.round(Number(media.audio_volume??0.8)*100));
      for(const [field,preview] of [['a-logo','preview-logo'],['a-logo-alt','preview-logo-alt'],['a-favicon','preview-favicon'],['a-background','preview-background'],['a-og','preview-og']])updatePreview(field,preview);
    }
    $('a-theme').addEventListener('change',syncAppearancePalette);
    function updatePreview(field,preview){const img=$(preview),url=$(field).value.trim();if(url){img.src=url;img.classList.remove('hidden');}else{img.removeAttribute('src');img.classList.add('hidden');}}
    for(const [field,preview] of [['a-logo','preview-logo'],['a-logo-alt','preview-logo-alt'],['a-favicon','preview-favicon'],['a-background','preview-background'],['a-og','preview-og']])$(field).addEventListener('input',()=>updatePreview(field,preview));
    $('appearance-form').addEventListener('submit',async(e)=>{
      e.preventDefault();const c=state.content||{};const existing=c.appearance||{};const theme=$('a-theme').value||'dark';
      const media={...(c.media||{}),logo_url:$('a-logo').value,alternate_logo_url:$('a-logo-alt').value,favicon_url:$('a-favicon').value,audio_url:$('a-audio').value,audio_volume:Math.min(1,Math.max(0,Number($('a-audio-volume').value)/100))};
      const palettes={...(existing.palettes||{})};palettes[theme]={...(palettes[theme]||{}),accent_color:$('a-accent').value,background_color:$('a-background-color').value};
      const appearance={...existing,theme,palettes,accent_color:$('a-accent').value,background_color:$('a-background-color').value,background_image_url:$('a-background').value};
      const payload={media,appearance,ogImage:$('a-og').value};$('save-appearance').disabled=true;
      try{await api('/api/admin/content',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});setStatus('appearance-status','Pengaturan tampilan berhasil disimpan.',true);await loadContent();await loadAppearance();}
      catch(e){setStatus('appearance-status',e.message);}finally{$('save-appearance').disabled=false;}
    });
    async function uploadSingle(file,category,globalType=''){const form=new FormData();form.append('file',file);form.append('category',category);if(globalType)form.append('global_type',globalType);return api('/api/admin/media',{method:'POST',body:form});}
    $('global-upload-form').addEventListener('submit',async(e)=>{e.preventDefault();const file=$('global-file').files?.[0];if(!file)return;$('global-upload-button').disabled=true;try{const result=await uploadSingle(file,'assets-global',$('global-kind').value);$('global-file').value='';setStatus('global-upload-status',result.warning||'Aset berhasil diunggah dan pengaturan diperbarui.',true);state.content={};await loadContent();await loadAppearance();await loadMedia();await loadDashboard();}catch(e){setStatus('global-upload-status',e.message);}finally{$('global-upload-button').disabled=false;}});

    async function loadNavigation(){const payload=await api('/api/admin/navigation');state.navigation=payload.data||[];state.navigationOriginal=state.navigation.map(item=>item.id);renderNavigation();}
    function renderNavigation(){const root=$('navigation-list');root.replaceChildren();if(!state.navigation.length)root.append(safeText('div','Belum ada item menu.','empty'));state.navigation.forEach((item,index)=>{const row=document.createElement('div');row.className='editor-row';const label=document.createElement('input');label.className='control';label.placeholder='Label';label.value=item.label||'';label.dataset.field='label';const href=document.createElement('input');href.className='control';href.placeholder='/halaman';href.value=item.href||'';href.dataset.field='href';const icon=document.createElement('input');icon.className='control';icon.placeholder='fa-icon';icon.value=item.icon||'';icon.dataset.field='icon';const controls=document.createElement('div');controls.className='toolbar';const enabled=document.createElement('input');enabled.type='checkbox';enabled.checked=item.enabled!==false;enabled.title='Tampilkan menu';enabled.dataset.field='enabled';const up=safeText('button','↑','btn ghost small-btn');up.type='button';up.disabled=index===0;up.addEventListener('click',()=>moveNav(index,-1));const down=safeText('button','↓','btn ghost small-btn');down.type='button';down.disabled=index===state.navigation.length-1;down.addEventListener('click',()=>moveNav(index,1));const remove=safeText('button','×','btn danger small-btn');remove.type='button';remove.addEventListener('click',()=>{if(confirm(`Hapus menu ${item.label}?`)){state.navigation.splice(index,1);renderNavigation();}});controls.append(enabled,up,down,remove);row.append(label,href,icon,controls);root.append(row);});}
    function moveNav(index,delta){const next=index+delta;if(next<0||next>=state.navigation.length)return;[state.navigation[index],state.navigation[next]]=[state.navigation[next],state.navigation[index]];renderNavigation();}
    $('add-navigation').addEventListener('click',()=>{const id=prompt('ID unik menu (huruf kecil, angka, tanda -):');if(!id)return;if(state.navigation.some(x=>x.id===id)){alert('ID sudah digunakan.');return;}state.navigation.push({id,label:'Menu baru',href:'/',icon:'fa-link',enabled:true});renderNavigation();});
    $('save-navigation').addEventListener('click',async()=>{const items=[...$('navigation-list').children].map((row,index)=>({id:state.navigation[index]?.id,label:row.querySelector('[data-field=label]').value,href:row.querySelector('[data-field=href]').value,icon:row.querySelector('[data-field=icon]').value,enabled:row.querySelector('[data-field=enabled]').checked}));const nextIds=new Set(items.map(item=>item.id));const removed=state.navigationOriginal.filter(id=>!nextIds.has(id));if(removed.length&&!confirm(`Hapus ${removed.length} menu dari website publik? (${removed.join(', ')})`))return;try{await api('/api/admin/navigation',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({items,confirmDelete:removed.length>0})});setStatus('navigation-status','Navigasi berhasil disimpan.',true);await loadNavigation();}catch(e){setStatus('navigation-status',e.message);}});
    $('reload-navigation').addEventListener('click',()=>loadNavigation().catch(e=>setStatus('navigation-status',e.message)));

    async function loadPages(){const payload=await api('/api/admin/pages');state.pages=payload.data||[];renderSeoList();fillSeoForm();}
    function fillSeoForm(){const page=state.pages.find(x=>x.slug===$('seo-page').value);writeIf('seo-title',page?.title);writeIf('seo-description',page?.description);writeIf('seo-og',page?.og_image);writeIf('seo-content',JSON.stringify(page?.content||{},null,2));$('seo-noindex').checked=page?.noindex===true;}
    function renderSeoList(){const root=$('seo-list');root.replaceChildren();for(const p of state.pages){const row=document.createElement('div');row.style.cssText='padding:10px 0;border-bottom:1px solid #292d39;display:flex;justify-content:space-between;gap:10px;align-items:center';row.append(safeText('strong',pageNames[p.slug]||p.slug),safeText('span',p.title||'Belum ada title','muted small'));const button=safeText('button','Edit','btn ghost small-btn');button.type='button';button.addEventListener('click',()=>{$('seo-page').value=p.slug;fillSeoForm();});row.append(button);root.append(row);}}
    $('seo-page').addEventListener('change',fillSeoForm);$('reload-seo').addEventListener('click',()=>loadPages().catch(e=>setStatus('seo-status',e.message)));
    $('seo-form').addEventListener('submit',async(e)=>{e.preventDefault();let content;try{content=JSON.parse($('seo-content').value||'{}');if(!content||Array.isArray(content)||typeof content!=='object')throw Error();}catch{setStatus('seo-status','Konten halaman harus berupa JSON object yang valid.');return;}const data={slug:$('seo-page').value,title:$('seo-title').value,description:$('seo-description').value,og_image:$('seo-og').value,noindex:$('seo-noindex').checked,content};try{await api('/api/admin/pages',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});setStatus('seo-status','Metadata SEO berhasil disimpan dan akan digunakan saat halaman dirender.',true);await loadPages();await loadDashboard();}catch(e){setStatus('seo-status',e.message);}});

    async function loadSections(){const payload=await api('/api/admin/sections');state.sections=payload.data||[];renderSections();}
    function renderSections(){const root=$('sections-list');root.replaceChildren();for(const item of state.sections){const row=document.createElement('div');row.className='editor-row';row.style.gridTemplateColumns='minmax(0,1fr) 130px 100px';row.append(safeText('strong',`${pageNames[item.page_slug]||item.page_slug} · ${item.label}`));const order=document.createElement('input');order.type='number';order.min='0';order.value=item.sort_order;order.className='control';order.dataset.field='sort_order';const visible=document.createElement('label');visible.className='checkline';const check=document.createElement('input');check.type='checkbox';check.checked=item.enabled!==false;check.dataset.field='enabled';visible.append(check,document.createTextNode(' Tampil'));row.append(order,visible);row.dataset.page=item.page_slug;row.dataset.key=item.section_key;root.append(row);}}
    $('save-sections').addEventListener('click',async()=>{const items=[...$('sections-list').children].map(row=>({page_slug:row.dataset.page,section_key:row.dataset.key,label:state.sections.find(x=>x.page_slug===row.dataset.page&&x.section_key===row.dataset.key)?.label,sort_order:Number(row.querySelector('[data-field=sort_order]').value)||0,enabled:row.querySelector('[data-field=enabled]').checked}));try{await api('/api/admin/sections',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({items})});setStatus('sections-status','Pengaturan section berhasil disimpan.',true);await loadSections();}catch(e){setStatus('sections-status',e.message);}});
    $('reload-sections').addEventListener('click',()=>loadSections().catch(e=>setStatus('sections-status',e.message)));

    async function loadMedia(){const params=new URLSearchParams();if($('media-filter').value)params.set('category',$('media-filter').value);if($('media-search').value.trim())params.set('q',$('media-search').value.trim());const payload=await api(`/api/admin/media?${params}`);state.media=payload.data||[];renderMedia();}
    function renderMedia(){const root=$('media-grid');root.replaceChildren();$('media-count').textContent=`${state.media.length} file · ${formatBytes(state.media.reduce((s,x)=>s+Number(x.size_bytes||0),0))}`;if(!state.media.length){root.append(safeText('div','Belum ada file yang cocok.','empty'));return;}for(const item of state.media){const card=document.createElement('article');card.className='media-card';if((item.mime_type||'').startsWith('image/')){const img=document.createElement('img');img.src=item.public_url;img.alt=item.alt_text||item.title||item.filename;card.append(img);}else{const preview=safeText('div',(item.mime_type||'').startsWith('audio/')?'♫':item.mime_type==='application/pdf'?'PDF':'FILE','file-preview');card.append(preview);}const body=document.createElement('div');body.className='media-card-body';body.append(safeText('strong',item.title||item.filename),safeText('small',`${item.category} · ${formatBytes(item.size_bytes)} · ${item.mime_type}`));const edit=safeText('button','Edit metadata','btn ghost small-btn');edit.type='button';edit.addEventListener('click',()=>editMedia(item));const replace=safeText('button','Ganti file','btn ghost small-btn');replace.type='button';const picker=document.createElement('input');picker.type='file';picker.hidden=true;picker.accept=(item.mime_type||'').startsWith('image/')?'image/*':(item.mime_type||'').startsWith('audio/')?'audio/*':'.pdf';picker.addEventListener('change',()=>{const file=picker.files?.[0];if(file)replaceMedia(item,file);});replace.addEventListener('click',()=>picker.click());const del=safeText('button','Hapus','btn danger small-btn');del.type='button';del.addEventListener('click',()=>deleteMedia(item));body.append(edit,replace,del,picker);card.append(body);root.append(card);}}
    async function editMedia(item){const title=prompt('Nama/metadata media:',item.title||item.filename);if(title===null)return;const alt=prompt('Alt text (untuk gambar):',item.alt_text||'');if(alt===null)return;try{await api('/api/admin/media',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:item.id,object_path:item.object_path,title,alt_text:alt,category:item.category,mime_type:item.mime_type,size_bytes:item.size_bytes})});await loadMedia();}catch(e){alert(e.message);}}
    async function replaceMedia(item,file){if(!confirm(`Ganti isi file ${item.filename}? URL tetap sama sehingga semua halaman yang memakai file ini akan ikut diperbarui.`))return;const form=new FormData();form.append('file',file);form.append('category',item.category);form.append('replace_path',item.object_path);try{const result=await api('/api/admin/media',{method:'POST',body:form});if(result.warning)alert(result.warning);await loadMedia();await loadDashboard();}catch(e){alert(e.message);}}
    async function deleteMedia(item){if(!confirm(`Hapus file ${item.filename} dari Storage? Jika masih digunakan, sistem akan menolak penghapusan.`))return;try{await api('/api/admin/media',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:item.id,object_path:item.object_path,confirm:true})});await loadMedia();await loadDashboard();}catch(e){alert(e.message);}}
    $('media-search').addEventListener('input',()=>loadMedia().catch(e=>setStatus('media-upload-status',e.message)));$('media-filter').addEventListener('change',()=>loadMedia().catch(e=>setStatus('media-upload-status',e.message)));$('refresh-media').addEventListener('click',()=>loadMedia().catch(e=>setStatus('media-upload-status',e.message)));
    $('media-upload-form').addEventListener('submit',async(e)=>{e.preventDefault();const files=[...$('media-files').files];if(!files.length)return;$('media-upload-button').disabled=true;let done=0;try{for(const file of files){await uploadSingle(file,$('media-category').value);done++;} $('media-files').value='';setStatus('media-upload-status',`${done} file berhasil diunggah.`,true);await loadMedia();await loadDashboard();}catch(e){setStatus('media-upload-status',`${done} file berhasil diunggah sebelum terjadi kendala: ${e.message}`);}finally{$('media-upload-button').disabled=false;}});

    $('export-backup').addEventListener('click',async()=>{try{const response=await fetch('/api/admin/backup',{credentials:'same-origin',cache:'no-store'});if(!response.ok){const err=await response.json().catch(()=>({}));throw Error(err.error||'Ekspor gagal.');}const blob=await response.blob();const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=`tkj-xi9-cms-${new Date().toISOString().slice(0,10)}.json`;link.click();URL.revokeObjectURL(url);setStatus('backup-status','Backup JSON berhasil dibuat.',true);}catch(e){setStatus('backup-status',e.message);}});
    $('import-backup-file').addEventListener('change',async()=>{const file=$('import-backup-file').files?.[0];if(!file)return;try{const bundle=JSON.parse(await file.text());if(!confirm('Impor data dari backup? Baris yang cocok akan diperbarui, baris yang tidak ada tetap dipertahankan.'))return;bundle.confirm=true;await api('/api/admin/backup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(bundle)});setStatus('backup-status','Data backup berhasil diimpor.',true);await loadDashboard();}catch(e){setStatus('backup-status',e.message);}finally{$('import-backup-file').value='';}});
    async function loadRevisions(){const slug=$('revision-page').value;const payload=await api(`/api/admin/revisions?slug=${encodeURIComponent(slug)}`);const root=$('revision-list');root.replaceChildren();if(!payload.data?.length){root.append(safeText('div','Belum ada riwayat versi.','empty'));return;}for(const revision of payload.data){const row=document.createElement('div');row.style.cssText='display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid #303544;border-radius:11px';const info=document.createElement('div');info.append(safeText('strong',`Versi ${revision.version}`),safeText('div',new Date(revision.created_at).toLocaleString('id-ID'),'muted small'));const button=safeText('button','Pulihkan','btn ghost small-btn');button.type='button';button.addEventListener('click',async()=>{if(!confirm(`Pulihkan versi ${revision.version} untuk ${slug}? Konten sekarang akan diganti.`))return;try{await api('/api/admin/revisions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:revision.id,confirm:true})});setStatus('revision-status','Versi berhasil dipulihkan. Muat ulang halaman publik untuk melihat hasilnya.',true);await loadDashboard();}catch(e){setStatus('revision-status',e.message);}});row.append(info,button);root.append(row);}}
    $('revision-page').addEventListener('change',()=>loadRevisions().catch(e=>setStatus('revision-status',e.message)));
    document.querySelector('[data-view="system"]').addEventListener('click',()=>loadRevisions().catch(e=>setStatus('revision-status',e.message)));

    checkSession();
  </script>
</body>
</html>
