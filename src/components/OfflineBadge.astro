<div id="offline-badge" role="status" aria-live="polite">
  <i class="fas fa-wifi" style="text-decoration:line-through" aria-hidden="true"></i>
  <span>Mode Offline</span>
</div>

<script>
  const badge = document.getElementById('offline-badge');
  if (badge) {
    function update() {
      badge.classList.toggle('terlihat', !navigator.onLine);
    }
    window.addEventListener('online', update);
    window.addEventListener('offline', update);
    update();
  }
</script>
