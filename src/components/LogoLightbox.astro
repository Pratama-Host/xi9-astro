---
import { getSettings } from '../lib/data';
const settings = await getSettings();
const logoUrl = settings.media?.logo_url || settings.media?.alternate_logo_url || null;
---
{logoUrl && (
  <div id="logo-jendela" class="logo-jendela" role="dialog" aria-modal="true" aria-label="Logo TKJ XI-9 diperbesar">
    <button class="tutup-logo-jendela" id="tutup-logo-jendela" aria-label="Tutup logo">
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
    <img id="gambar-logo-jendela" src={logoUrl} alt="Logo TKJ XI-9" />
  </div>
)}
