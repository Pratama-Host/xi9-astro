---
const items = [
  { href: "/", text: "Home", icon: 'fa-house' },
  { href: "/pengembang", text: "Developer", icon: 'fa-code' },
  { href: "/struktur", text: "Struktur", icon: 'fa-sitemap' },
  { href: "/anggota", text: "Anggota", icon: 'fa-users' },
  { href: "/keahlian", text: "Skills", icon: 'fa-code' },
  { href: "/galeri", text: "Galeri", icon: 'fa-images' },
  { href: "/tkj", text: "TKJ", icon: 'fa-network-wired' },
];
---

<button id="hamburger-tombol" class="hamburger-tombol" aria-label="Buka menu" aria-expanded="false">
  <span class="hamburger-icon"><i class="fas fa-bars" aria-hidden="true"></i></span>
</button>

<nav id="menu-hamburger" aria-hidden="true">
  <div class="panel-menu-hamburger">
    <button type="button" class="tutup-menu-hamburger" aria-label="Tutup menu">
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
    {items.map((item) => (
      <a class="tautan-menu-hamburger" href={item.href}>
        <span><i class={`fas ${item.icon}`}></i></span>
        <span>{item.text}</span>
      </a>
    ))}
  </div>
</nav>
